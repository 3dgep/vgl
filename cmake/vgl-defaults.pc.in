prefix=${pcfiledir}/@VGL_PC_RELATIVE_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: vgl-defaults
Description: Default thread pool, file reader, disk cache and optional HTTP reader for vgl
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Requires: vgl = @PROJECT_VERSION@
Requires.private: @VGL_DEFAULTS_PC_REQUIRES_PRIVATE@
Cflags: -I${includedir}
Libs: -L${libdir} -lvgl-defaults
Libs.private: @VGL_DEFAULTS_PC_LIBS_PRIVATE@
