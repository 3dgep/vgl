prefix=${pcfiledir}/@VGL_PC_RELATIVE_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: vgl
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Requires.private: @VGL_PC_REQUIRES_PRIVATE@
Cflags: -I${includedir} @VGL_PC_CFLAGS@
Libs: -L${libdir} -lvgl
Libs.private: @VGL_PC_LIBS_PRIVATE@
