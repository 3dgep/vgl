# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Jeremiah van Oosten
#
# The reference server for vgl packs (docs/hosting.md), for Caddy 2.11: a read-only server of
# pack files with range requests, safe to expose on a public endpoint.
#
#     caddy run --config tools/server/Caddyfile
#
# Settings, from the environment:
#
#     VGL_SITE         The address to serve. A domain name ("packs.example.org") serves HTTPS
#                      with a certificate Caddy obtains and renews, and redirects HTTP to it; a
#                      port (":8080", the default) serves plain HTTP, for local use or behind a
#                      proxy or CDN that terminates TLS.
#     VGL_PACKS        The directory that holds the packs, each in a subdirectory: "packs" by
#                      default, relative to the working directory.
#     VGL_CORS_ORIGIN  The origin that browsers may read packs from: "*" by default.
#
# Only pack files are served: manifests (pack.vglm) and shards (*.vgls), with GET and HEAD.
# There are no directory listings, no hidden files, no compression (which would break byte
# ranges) and one range per request.
{
	# No admin endpoint: restart Caddy to change the configuration.
	admin off

	servers {
		timeouts {
			read_header 10s
			read_body 10s
			write 2m
			idle 2m
		}
		max_header_size 16KB
	}
}

{$VGL_SITE::8080} {
	root * {$VGL_PACKS:packs}

	log {
		output stdout
		format console
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Access-Control-Allow-Origin {$VGL_CORS_ORIGIN:*}
		# Cross-origin isolated pages, as vgl's web build is, load it however they ask.
		Cross-Origin-Resource-Policy cross-origin
		Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, ETag"
	}

	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000"

	route {
		@not_allowed not method GET HEAD OPTIONS
		header @not_allowed Allow "GET, HEAD, OPTIONS"
		respond @not_allowed 405

		# Browsers ask before sending a Range header from another origin.
		@preflight method OPTIONS
		header @preflight {
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
			Access-Control-Allow-Headers "Range, If-None-Match, If-Range"
			Access-Control-Max-Age 86400
		}
		respond @preflight 204

		# vgl asks for one range at a time; several in one request only cost the server.
		@ranges header_regexp Range ,
		respond @ranges 416

		@hidden path_regexp /\.
		respond @hidden 404

		# A manifest changes in place when a pack is rebaked, so caches check it again after a
		# minute. A shard's name holds a digest of its content, so caches may keep it forever.
		@manifest path */pack.vglm
		header @manifest Cache-Control "public, max-age=60"
		@shard path *.vgls
		header @shard Cache-Control "public, max-age=31536000, immutable"

		@pack path */pack.vglm *.vgls
		header @pack Content-Type application/octet-stream
		file_server @pack

		respond 404
	}
}
