{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VGL_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "description": "Uses the newest installed Visual Studio generator.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-gcc-base",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-clang-base",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "windows-msvc-static",
      "displayName": "Windows MSVC, static",
      "inherits": "windows-base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "windows-msvc-shared",
      "displayName": "Windows MSVC, shared",
      "inherits": "windows-base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "VGL_DEFAULTS_HTTP": "ON"
      }
    },
    {
      "name": "windows-msvc-noexcept",
      "displayName": "Windows MSVC, no exceptions",
      "inherits": "windows-base",
      "cacheVariables": {
        "VGL_DISABLE_EXCEPTIONS": "ON"
      }
    },
    {
      "name": "linux-gcc-static",
      "displayName": "Linux GCC, static",
      "inherits": "linux-gcc-base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "linux-gcc-shared",
      "displayName": "Linux GCC, shared",
      "inherits": "linux-gcc-base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "VGL_DEFAULTS_HTTP": "ON"
      }
    },
    {
      "name": "linux-gcc-noexcept",
      "displayName": "Linux GCC, no exceptions",
      "inherits": "linux-gcc-base",
      "cacheVariables": {
        "VGL_DISABLE_EXCEPTIONS": "ON"
      }
    },
    {
      "name": "linux-clang-static",
      "displayName": "Linux Clang, static",
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "linux-clang-shared",
      "displayName": "Linux Clang, shared",
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "VGL_DEFAULTS_HTTP": "ON"
      }
    },
    {
      "name": "linux-clang-noexcept",
      "displayName": "Linux Clang, no exceptions",
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "VGL_DISABLE_EXCEPTIONS": "ON"
      }
    },
    {
      "name": "windows-msvc-baker",
      "displayName": "Windows MSVC, static, with the baker (conda-forge GDAL)",
      "description": "Activate the environment from tools/baker/environment.yml first, so that CONDA_PREFIX is set.",
      "inherits": "windows-base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "VGL_BUILD_BAKER": "ON",
        "CMAKE_PREFIX_PATH": "$env{CONDA_PREFIX}/Library"
      }
    },
    {
      "name": "linux-gcc-baker",
      "displayName": "Linux GCC, static, with the baker",
      "inherits": "linux-gcc-base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "VGL_BUILD_BAKER": "ON"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-clang-static",
      "displayName": "macOS Apple Clang, static",
      "inherits": "macos-base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "macos-clang-shared",
      "displayName": "macOS Apple Clang, shared",
      "inherits": "macos-base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a, static (cross-build)",
      "description": "Needs ANDROID_NDK set to an NDK (r27c is tested). The minimum is Android 7.0 (API 24), 64-bit (design document, section 4).",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{ANDROID_NDK}",
        "rhs": ""
      },
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_static",
        "BUILD_SHARED_LIBS": "OFF",
        "VGL_ZSTD_PROVIDER": "BUNDLED"
      }
    },
    {
      "name": "ios-arm64",
      "displayName": "iOS arm64, static (cross-build)",
      "description": "The minimum is iOS 15 (design document, section 4).",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "BUILD_SHARED_LIBS": "OFF",
        "VGL_ZSTD_PROVIDER": "BUNDLED"
      }
    }
  ],
